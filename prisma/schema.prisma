// prisma/schema.prisma - COMPLETE AND CORRECT
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MTN_MOMO
  ORANGE_MONEY
  CARD
  CASH
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  tickets       Ticket[]
  payments      Payment[]
  
  // Poll relations
  polls         Poll[]
  votes         Vote[]
  
  // Event relations
  createdEvents   Event[] @relation("CreatedEvents")
  organizedEvents Event[] @relation("OrganizedEvents")

  @@map("users")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  published   Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  location    String
  imageUrl    String?

  createdById String
  createdBy   User   @relation("CreatedEvents", fields: [createdById], references: [id], onDelete: Cascade)

  organizerId String?
  organizer   User?   @relation("OrganizedEvents", fields: [organizerId], references: [id])

  tickets     Ticket[]
  polls       Poll[]
  payments    Payment[]

  createdAt DateTime @default(now())

  @@index([createdById])
  @@index([organizerId])
}

model Ticket {
  id       String  @id @default(cuid())
  type     String
  price    Float
  quantity Int
  eventId  String
  userId   String
  orders   Order[]
  payments Payment[]
  user     User    @relation(fields: [userId], references: [id])
  event    Event   @relation(fields: [eventId], references: [id])

  @@map("tickets")
}

model Order {
  id         String   @id @default(cuid())
  userId     String
  ticketId   String
  quantity   Int
  totalPrice Float
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@map("orders")
}

model Poll {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String    @default("POLL")
  status      String    @default("ACTIVE")
  isFeatured  Boolean   @default(false)
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creatorId   String
  eventId     String?
  options     Option[]
  event       Event?    @relation(fields: [eventId], references: [id])
  creator     User      @relation(fields: [creatorId], references: [id])
  votes       Vote[]

  @@map("polls")
}

model Option {
  id       String  @id @default(cuid())
  text     String
  imageUrl String?
  pollId   String
  poll     Poll    @relation(fields: [pollId], references: [id])
  votes    Vote[]

  @@map("options")
}

model Vote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  option    Option   @relation(fields: [optionId], references: [id])
  poll      Poll     @relation(fields: [pollId], references: [id])

  @@unique([pollId, userId])
  @@map("votes")
}

model Payment {
  id            String   @id @default(cuid())
  amount        Float
  currency      String   @default("LRD")
  status        PaymentStatus @default(PENDING)
  provider      PaymentProvider @default(MTN_MOMO)
  providerRef   String?  // MTN transaction ID
  callbackData  Json?    // Store MoMo callback payload
  
  // Relationships
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  ticketId      String?
  ticket        Ticket?  @relation(fields: [ticketId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([providerRef])
  @@index([status])
}