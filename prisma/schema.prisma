generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Replace enums with String constraints
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("USER") // Instead of Role enum
  status    String   @default("active") // active, suspended
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       Event[]
  polls        Poll[]
  votes        Vote[]
  orders       Order[]
  payments     Payment[]
  reservations TicketReservation[]
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String
  deletedAt   DateTime?
  imageUrl    String?
  published   Boolean   @default(false)
  isFeatured  Boolean   @default(false)

  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  ticketTypes TicketType[]
  polls       Poll[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([date])
  @@index([published])
}

model TicketType {
  id          String    @id @default(cuid())
  name        String
  price       Float
  quantity    Int
  maxPerOrder Int       @default(5)
  salesStart  DateTime?
  salesEnd    DateTime?
  description String?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  tickets      TicketInstance[]
  reservations TicketReservation[]
  pricingRules PricingRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model TicketInstance {
  id          String  @id @default(cuid())
  status      String  @default("RESERVED") // RESERVED, PAID, USED, CANCELLED, EXPIRED
  qrCode      String  @unique
  guestName   String?
  guestEmail  String?
  phoneNumber String?
  qrImage     String?
  pdfUrl      String?

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  validatedAt DateTime?
  // ❌ REMOVED: metadata Json? - Not supported in SQLite
  // Store metadata as String (JSON) if needed
  metadata    String? // Store as JSON string

  // Checked at 
  scannedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketTypeId])
  @@index([status])
  @@index([qrCode])
  @@index([orderId])
}

model Order {
  id         String @id @default(cuid())
  status     String @default("PENDING")
  totalPrice Float

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  payments Payment[]

  tickets TicketInstance[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  TicketReservation TicketReservation[]
  ticketGenerated   Boolean             @default(false)
  pdfUrl            String? // store the generated ticket PDF path

  @@index([userId])
  @@index([status])
}

model Payment {
  id          String  @id @default(cuid())
  providerRef String? @unique
  externalId  String? @unique
  amount      Float
  currency    String
  status      String  @default("PENDING")

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  paymentMethod String?
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Event     Event?   @relation(fields: [eventId], references: [id])
  eventId   String?

  @@index([status])
}

// Update Poll model 
model Poll {
  id          String    @id @default(cuid())
  title       String
  description String?
  pollType    String    @default("FREE")
  status      String    @default("ACTIVE")
  endDate     DateTime?
  deletedAt   DateTime?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  options Option[]
  votes   Vote[]

  // Add a partial unique index or validation comment
  // Valid values: "FREE", "PAID" - validated in application
}

model Option {
  id       String  @id @default(cuid())
  text     String
  imageUrl String?

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  votes Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vote {
  id String @id @default(cuid())

  pollId   String
  optionId String
  userId   String?

  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option Option @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // For guest voting 
  deviceId String? // For non-authenticated users

  // Store additional data as JSON string
  metadata String? // JSON string

  createdAt DateTime @default(now())

  @@unique([pollId, userId]) // Registered users only
  @@index([pollId])
  @@index([optionId])
  @@index([deviceId]) // Add index for deviceId lookups
}

model TicketReservation {
  id           String   @id @default(cuid())
  ticketTypeId String
  orderId      String
  quantity     Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  User       User?      @relation(fields: [userId], references: [id])
  userId     String?

  @@index([orderId])
  @@index([ticketTypeId])
  @@index([expiresAt])
}

model PricingRule {
  id           String     @id @default(cuid())
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  type        String
  price       Float?
  startDate   DateTime?
  endDate     DateTime?
  maxQuantity Int?

  createdAt DateTime @default(now())

  @@index([ticketTypeId])
}
