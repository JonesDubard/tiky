generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Replace enums with String constraints
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String?
  role          String   @default("USER") // Instead of Role enum
  status        String   @default("active") // active, suspended
  image         String?
  phoneNumber   String?  @unique
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events       Event[]
  polls        Poll[]
  createdPolls Poll[]              @relation("PollCreator")
  votes        Vote[]
  orders       Order[]
  payments     Payment[]
  reservations TicketReservation[]
  Post         Post[]
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String
  deletedAt   DateTime?
  imageUrl    String?
  published   Boolean   @default(false)
  isFeatured  Boolean   @default(false)

  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  ticketTypes TicketType[]
  polls       Poll[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Order     Order[]

  @@index([createdById])
  @@index([date])
  @@index([published])
}

model TicketType {
  id          String    @id @default(cuid())
  name        String
  price       Float
  quantity    Int
  maxPerOrder Int       @default(5)
  salesStart  DateTime?
  salesEnd    DateTime?
  description String?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  tickets      TicketInstance[]
  reservations TicketReservation[]
  pricingRules PricingRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

model TicketInstance {
  id          String  @id @default(cuid())
  status      String  @default("RESERVED") // RESERVED, PAID, USED, CANCELLED, EXPIRED
  qrCode      String  @unique
  guestName   String?
  guestEmail  String?
  phoneNumber String?
  qrImage     String?
  pdfUrl      String?

  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  validatedAt DateTime?
  // ❌ REMOVED: metadata Json? - Not supported in SQLite
  // Store metadata as String (JSON) if needed
  metadata    String? // Store as JSON string

  scannedAt DateTime?
  votes     Vote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketTypeId])
  @@index([status])
  @@index([qrCode])
  @@index([orderId])
}

model Order {
  id         String @id @default(cuid())
  status     String @default("PENDING")
  totalPrice Float

  referenceCode String? @unique
  proofUrl      String?
  proofNote     String?
  paymentMethod String?

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  payments Payment[]
  tickets  TicketInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  TicketReservation TicketReservation[]
  ticketGenerated   Boolean             @default(false)
  pdfUrl            String?

  @@index([userId])
  @@index([status])
  @@index([eventId])
  @@index([referenceCode])
}

model Payment {
  id          String  @id @default(cuid())
  providerRef String? @unique
  externalId  String? @unique
  amount      Float
  currency    String
  status      String  @default("PENDING")

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  paymentMethod String?
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId   String?

  @@index([status])
}

// Update Poll model 
model Poll {
  id             String    @id @default(cuid())
  title          String
  description    String?
  status         String    @default("ACTIVE") // ACTIVE, CLOSED
  pollType       String    @default("PUBLIC") // PUBLIC, TOKEN_GATED
  endDate        DateTime? // close date
  isFeatured     Boolean   @default(false)
  eventId        String? // link to event for PAID/TOKEN_GATED
  createdById    String? // creator FK
  deletedAt      DateTime?
  requiresTicket Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  linkedEventId  String?

  options PollOption[]
  votes   Vote[]
  event   Event?       @relation(fields: [eventId], references: [id])
  creator User?        @relation("PollCreator", fields: [createdById], references: [id])
  User    User?        @relation(fields: [userId], references: [id])
  userId  String?
}

model PollOption {
  id        String   @id @default(cuid())
  text      String
  imageUrl  String?
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id])
  votes     Vote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vote {
  id String @id @default(cuid())

  pollId   String
  optionId String
  userId   String?

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId         String?
  metadata         String?
  ticketInstanceId String?
  ticketInstance   TicketInstance? @relation(fields: [ticketInstanceId], references: [id])

  createdAt DateTime @default(now())

  @@unique([pollId, userId]) // Registered users only
  @@index([pollId])
  @@index([optionId])
  @@index([deviceId]) // Add index for deviceId lookups
}

model TicketReservation {
  id           String   @id @default(cuid())
  ticketTypeId String
  orderId      String
  quantity     Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  User       User?      @relation(fields: [userId], references: [id])
  userId     String?

  @@index([orderId])
  @@index([ticketTypeId])
  @@index([expiresAt])
}

model PricingRule {
  id           String     @id @default(cuid())
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  type        String
  price       Float?
  startDate   DateTime?
  endDate     DateTime?
  maxQuantity Int?

  createdAt DateTime @default(now())

  @@index([ticketTypeId])
}

// Blog
model Post {
  id         String    @id @default(cuid())
  title      String
  slug       String    @unique
  content    String    @db.Text
  coverImage String?
  published  Boolean   @default(false)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@index([key])
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}
